{
  "name": "smart-publisher",
  "displayName": "smart-publisher — 一键发微信/知乎/小红书/Twitter",
  "description": "写完一篇 Markdown，一键复制到微信公众号 / 知乎 / 小红书，导出小红书长图，AI 去 AI 味与选区改写，浏览器自动发布知乎 / 今日头条。支持 LaTeX 公式、14 套主题、实时预览。",
  "version": "1.1.0",
  "publisher": "spin",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#2d7a3e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other",
    "Formatters"
  ],
  "keywords": [
    "markdown",
    "wechat",
    "微信公众号",
    "小红书",
    "xiaohongshu",
    "知乎",
    "zhihu",
    "twitter",
    "X",
    "一键发布",
    "publish",
    "LLM",
    "文案生成",
    "KaTeX",
    "preview",
    "去AI味",
    "humanize",
    "知乎发布",
    "头条发布",
    "AI改写"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:markdown",
    "onCommand:smart-publisher.preview",
    "onCommand:smart-publisher.exportHtml",
    "onCommand:smart-publisher.humanize",
    "onCommand:smart-publisher.aiRewriteSelection",
    "onCommand:smart-publisher.publishZhihu",
    "onCommand:smart-publisher.publishToutiao",
    "onCommand:smart-publisher.publisherLogin",
    "onCommand:smart-publisher.publisherStatus"
  ],
  "contributes": {
    "commands": [
      {
        "command": "smart-publisher.preview",
        "title": "打开预览 / 发布面板",
        "category": "smart-publisher",
        "icon": "$(open-preview)"
      },
      {
        "command": "smart-publisher.exportHtml",
        "title": "导出 HTML 文件",
        "category": "smart-publisher",
        "icon": "$(export)"
      },
      {
        "command": "smart-publisher.humanize",
        "title": "去 AI 味（检测 + 改写）",
        "category": "smart-publisher",
        "icon": "$(sparkle)"
      },
      {
        "command": "smart-publisher.aiRewriteSelection",
        "title": "AI 改写选中文字",
        "category": "smart-publisher",
        "icon": "$(edit)"
      },
      {
        "command": "smart-publisher.publishZhihu",
        "title": "发布到知乎（浏览器自动化）",
        "category": "smart-publisher",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "smart-publisher.publishToutiao",
        "title": "发布到今日头条（浏览器自动化）",
        "category": "smart-publisher",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "smart-publisher.publisherLogin",
        "title": "发布平台：扫码登录",
        "category": "smart-publisher",
        "icon": "$(account)"
      },
      {
        "command": "smart-publisher.publisherStatus",
        "title": "发布平台：检查登录状态",
        "category": "smart-publisher",
        "icon": "$(check)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "smart-publisher.preview",
          "when": "resourceLangId == markdown",
          "group": "navigation"
        },
        {
          "command": "smart-publisher.humanize",
          "when": "resourceLangId == markdown",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "smart-publisher.preview",
          "when": "resourceLangId == markdown",
          "group": "1_modification"
        },
        {
          "command": "smart-publisher.humanize",
          "when": "resourceLangId == markdown",
          "group": "1_modification"
        },
        {
          "command": "smart-publisher.aiRewriteSelection",
          "when": "editorHasSelection",
          "group": "1_modification"
        },
        {
          "command": "smart-publisher.exportHtml",
          "when": "resourceLangId == markdown",
          "group": "1_modification"
        },
        {
          "command": "smart-publisher.publishZhihu",
          "when": "resourceLangId == markdown",
          "group": "9_publish"
        },
        {
          "command": "smart-publisher.publishToutiao",
          "when": "resourceLangId == markdown",
          "group": "9_publish"
        }
      ],
      "explorer/context": [
        {
          "command": "smart-publisher.preview",
          "when": "resourceExtname == .md",
          "group": "1_modification"
        },
        {
          "command": "smart-publisher.publishZhihu",
          "when": "resourceExtname == .md",
          "group": "9_publish"
        },
        {
          "command": "smart-publisher.publishToutiao",
          "when": "resourceExtname == .md",
          "group": "9_publish"
        },
        {
          "command": "smart-publisher.exportHtml",
          "when": "resourceExtname == .md",
          "group": "1_modification"
        }
      ]
    },
    "keybindings": [
      {
        "command": "smart-publisher.preview",
        "key": "ctrl+shift+w",
        "mac": "cmd+shift+w",
        "when": "resourceLangId == markdown"
      },
      {
        "command": "smart-publisher.humanize",
        "key": "ctrl+alt+h",
        "mac": "cmd+alt+h",
        "when": "resourceLangId == markdown"
      },
      {
        "command": "smart-publisher.aiRewriteSelection",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "editorHasSelection"
      }
    ],
    "configuration": {
      "title": "smart-publisher",
      "properties": {
        "smart-publisher.theme": {
          "type": "string",
          "default": "claude",
          "description": "默认主题 id（微信经典 wechat / claude / macOS / dark / zhihu / monochrome / spring / academic / xhs / notion / claude-pro / medium / ryf / clean-blue）。"
        },
        "smart-publisher.outputPath": {
          "type": "string",
          "default": "",
          "description": "导出 HTML 的目录（相对于工作区根目录）。留空则导出到 md 文件同目录。"
        },
        "smart-publisher.template": {
          "type": "string",
          "default": "wechat",
          "description": "复制到微信使用的 HTML 模板名（对应扩展 templates/ 下同名 .html）。"
        },
        "smart-publisher.llm.baseUrl": {
          "type": "string",
          "default": "https://api.deepseek.com/v1",
          "description": "AI 文案生成用的 LLM 接口地址（OpenAI 兼容 /chat/completions）。可填 DeepSeek、硅基流动、OpenRouter、本地 Ollama 等。"
        },
        "smart-publisher.llm.model": {
          "type": "string",
          "default": "deepseek-chat",
          "description": "AI 文案生成用的模型名，如 deepseek-chat、gpt-4o-mini、Qwen/Qwen2.5-7B-Instruct 等。"
        },
        "smart-publisher.llm.sendFullText": {
          "type": "boolean",
          "default": true,
          "description": "生成 AI 文案时，是否把 Markdown 正文一起发给模型（关闭则只发标题与摘要，更省 token）。"
        },
        "smart-publisher.xhs.exportMode": {
          "type": "string",
          "enum": [
            "classic",
            "adaptive"
          ],
          "default": "classic",
          "description": "小红书长图导出模式。classic：保留当前主题样式；adaptive：使用适合 3:4 手机图片阅读的大字体排版。"
        },
        "smart-publisher.xhs.adaptiveUseTheme": {
          "type": "boolean",
          "default": true,
          "description": "手机自适应截图是否跟随预览器主题色。开启则自动使用当前主题的强调色，关闭则固定小红书红 #ff2442。"
        },
        "smart-publisher.humanize.targetScore": {
          "type": "number",
          "default": 25,
          "minimum": 0,
          "maximum": 100,
          "description": "去 AI 味的目标分数（0-100）。生成改写 prompt 时会要求模型把检测分数降到该值以下；25 以下通常算「自然」。"
        },
        "smart-publisher.publisher.pythonPath": {
          "type": "string",
          "default": "",
          "description": "自动发布用的 Python 解释器路径（需要 Python 3.9+）。留空则使用 python3（Windows 为 python）。"
        },
        "smart-publisher.publisher.dataDir": {
          "type": "string",
          "default": "",
          "description": "知乎 / 今日头条登录态目录。留空则使用 ~/.smart-publisher（会兼容旧的 ~/.opencode-publisher 登录态）。"
        }
      }
    }
  },
  "dependencies": {
    "highlight.js": "^11.9.0",
    "html2canvas": "^1.4.1",
    "katex": "^0.16.0"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.2",
    "cheerio": "1.0.0-rc.12",
    "esbuild": "^0.28.2",
    "gray-matter": "^4.0.3",
    "juice": "^9.1.0",
    "marked": "^11.1.1",
    "mathjax-full": "^3.2.1"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "vscode:prepublish": "npm run build",
    "test": "node test/humanize.test.js && node test/rewrite.test.js && node test/render.test.js && node test/host.test.js",
    "test:bundle": "npm run build && node test/humanize.test.js && node test/rewrite.test.js && node test/render.test.js && SP_EXT_ENTRY=./dist/extension.js node test/host.test.js",
    "test:package": "node scripts/verify-package.js",
    "package": "vsce package",
    "install-ext": "node scripts/install.js",
    "icon": "node scripts/make-icon.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/spin-ai/spin-publish.git"
  },
  "overrides": {
    "cheerio": "1.0.0-rc.12"
  }
}
